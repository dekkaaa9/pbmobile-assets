# ============================================================
#  PBMobile clone — .gitignore
#  Repo ini KODE + DOKUMEN. Aset besar lewat GitHub Release.
# ============================================================

# ---- dependensi ----
node_modules/
package-lock.json

# ---- file sementara / output ----
*.log
*.txt
*.tmp
*.orig
*.rej

# ---- file sistem & editor ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---- KREDENSIAL (jangan pernah ke-commit) ----
.env
.env.*
*.pem
*.key
vps.js
deploy/credentials*
*.ppk

# ---- ASET BESAR -> pakai GitHub Release, BUKAN git ----
# Release "v1.0", 2 file (generate via tools/build_release.js):
#   dist/site-runtime.tar.gz  723 MB  = site/ lengkap KECUALI export/ -> bisa langsung jalan
#   dist/site-export.tar.gz   539 MB  = site/export/ (GLB/WebP/maps)
# Dipisah 2 file karena site/ utuh 2,05 GB > limit Release 2 GB per file.
site/assets/
site/rml/

# ---- OLAHAN ANALISIS (846 MB glb/webp/maps) -> nggak di git ----
# Kalau mau dibagi, bikin release terpisah: export_pb.tar.gz
site/export/

# ---- TARBALL (723 MB, duplikat isi site/) ----
dist/

# ============================================================
#  SISANYA SEMUA MASUK REPO:
#    *.md                     dokumentasi
#    site/index.html, cc.js, *.html, *.json
#    site/static/**           kode client (27 MB)
#    site/debug.html
#    tools/**                 script (exclude node_modules)
#    cheat/**                 userscript + panduan
#    deploy/**                script deploy VPS
# ============================================================
